<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DIY Executive Assistant Kit — Clairen Haus</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg: #08080e;
    --bg-surface: #0d0d1a;
    --bg-card: #111122;
    --teal: #00d4c8;
    --blue: #3c8cff;
    --purple: #8c50ff;
    --orange: #ff8c32;
    --text-white: #f0f0f8;
    --text-muted: #8888aa;
    --text-dim: #555570;
    --gradient: linear-gradient(90deg, var(--teal), var(--blue), var(--purple));
    --gradient-text: linear-gradient(135deg, var(--teal) 0%, var(--blue) 50%, var(--purple) 100%);
    --font-display: 'Plus Jakarta Sans', sans-serif;
    --font-body: 'Inter', sans-serif;
  }

  html { scroll-behavior: smooth; }

  body {
    background: var(--bg);
    color: var(--text-white);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
    overflow-x: hidden;
  }

  .gradient-bar {
    height: 3px;
    background: var(--gradient);
    width: 100%;
    display: block;
  }

  /* NAV */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    background: rgba(8,8,14,0.9);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(0,212,200,0.1);
  }
  .nav-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .nav-logo {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 15px;
    letter-spacing: 0.12em;
    color: var(--teal);
    text-decoration: none;
    text-transform: uppercase;
  }
  .nav-logo span { color: var(--text-muted); font-weight: 400; }
  .nav-cta {
    background: var(--orange);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.06em;
    padding: 9px 22px;
    cursor: pointer;
    text-decoration: none;
    transition: opacity 0.2s;
    text-transform: uppercase;
  }
  .nav-cta:hover { opacity: 0.88; }

  /* HERO */
  .hero {
    padding: 130px 24px 96px;
    max-width: 1100px;
    margin: 0 auto;
    position: relative;
  }
  .hero::before {
    content: '';
    position: absolute;
    top: 100px; left: -5%;
    width: 500px; height: 500px;
    background: radial-gradient(ellipse, rgba(0,212,200,0.06) 0%, transparent 70%);
    pointer-events: none;
    z-index: -1;
  }
  .hero::after {
    content: '';
    position: absolute;
    top: 200px; right: 0;
    width: 400px; height: 400px;
    background: radial-gradient(ellipse, rgba(140,80,255,0.06) 0%, transparent 70%);
    pointer-events: none;
    z-index: -1;
  }
  .hero-layout {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 64px;
    align-items: center;
  }
  @media (max-width: 860px) {
    .hero-layout { grid-template-columns: 1fr; }
    .hero-card-wrap { order: -1; }
  }

  .hero-eyebrow {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--orange);
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .hero-eyebrow::before {
    content: '';
    display: inline-block;
    width: 28px;
    height: 2px;
    background: var(--orange);
  }
  .hero h1 {
    font-family: var(--font-display);
    font-size: clamp(34px, 5.5vw, 58px);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin-bottom: 22px;
  }
  .hero h1 .grad {
    background: var(--gradient-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hero-sub {
    font-size: clamp(15px, 1.8vw, 18px);
    color: var(--text-muted);
    line-height: 1.75;
    font-weight: 300;
    margin-bottom: 32px;
    max-width: 520px;
  }
  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 36px;
  }
  .tag {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    padding: 6px 14px;
    border: 1px solid rgba(255,255,255,0.1);
    color: var(--text-muted);
    text-transform: uppercase;
  }
  .tag.teal { border-color: rgba(0,212,200,0.3); color: var(--teal); }

  /* PRODUCT CARD */
  .product-card {
    background: var(--bg-card);
    border: 1px solid rgba(255,255,255,0.08);
    padding: 36px 32px;
    position: relative;
  }
  .product-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: var(--gradient);
  }
  .card-label {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 16px;
  }
  .card-title {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 800;
    margin-bottom: 20px;
    line-height: 1.3;
  }
  .card-price-wrap {
    margin-bottom: 20px;
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  .card-price {
    font-family: var(--font-display);
    font-size: 56px;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    background: var(--gradient-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .card-price sup {
    font-size: 24px;
    font-weight: 600;
    vertical-align: super;
    -webkit-text-fill-color: transparent;
  }
  .card-price-note {
    font-size: 13px;
    color: var(--text-dim);
    margin-top: 4px;
  }
  .card-includes {
    list-style: none;
    margin-bottom: 24px;
  }
  .card-includes li {
    font-size: 14px;
    color: var(--text-muted);
    padding: 8px 0;
    display: flex;
    gap: 10px;
    align-items: flex-start;
    border-bottom: 1px solid rgba(255,255,255,0.04);
  }
  .card-includes li:last-child { border-bottom: none; }
  .card-includes li::before {
    content: '✓';
    color: var(--teal);
    font-weight: 700;
    font-size: 13px;
    flex-shrink: 0;
    margin-top: 1px;
  }
  .btn-buy {
    display: block;
    width: 100%;
    background: var(--orange);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 16px;
    text-align: center;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: opacity 0.2s;
    margin-bottom: 12px;
  }
  .btn-buy:hover { opacity: 0.88; }
  .card-guarantee {
    font-size: 12px;
    color: var(--text-dim);
    text-align: center;
    line-height: 1.5;
  }

  /* SECTIONS */
  .section {
    padding: 88px 24px;
    max-width: 1100px;
    margin: 0 auto;
  }
  .section-label {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--teal);
    margin-bottom: 16px;
  }
  .section-title {
    font-family: var(--font-display);
    font-size: clamp(26px, 3.5vw, 40px);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 16px;
  }
  .section-body {
    font-size: 17px;
    color: var(--text-muted);
    max-width: 580px;
    line-height: 1.75;
    font-weight: 300;
  }
  .full-divider {
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(0,212,200,0.15), transparent);
  }

  /* WHAT'S INSIDE */
  .inside-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 2px;
    margin-top: 48px;
  }
  .inside-item {
    background: var(--bg-card);
    border: 1px solid rgba(255,255,255,0.05);
    padding: 36px 30px;
    transition: border-color 0.2s;
  }
  .inside-item:hover { border-color: rgba(0,212,200,0.2); }
  .inside-icon {
    font-size: 32px;
    display: block;
    margin-bottom: 16px;
  }
  .inside-item h3 {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
    margin-bottom: 10px;
  }
  .inside-item p {
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.65;
  }

  /* TOOL STACK */
  .tools-bg {
    background: var(--bg-surface);
    padding: 88px 0;
  }
  .tools-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 16px;
    margin-top: 48px;
  }
  .tool-card {
    background: var(--bg-card);
    border: 1px solid rgba(255,255,255,0.06);
    padding: 32px 28px;
    position: relative;
    overflow: hidden;
  }
  .tool-card::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 2px;
    background: var(--gradient);
  }
  .tool-role {
    font-family: var(--font-display);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--teal);
    margin-bottom: 10px;
  }
  .tool-name {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 800;
    margin-bottom: 4px;
  }
  .tool-cost {
    font-size: 13px;
    color: var(--orange);
    font-weight: 600;
    margin-bottom: 14px;
    font-family: var(--font-display);
  }
  .tool-desc {
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: 16px;
  }
  .tool-why {
    font-size: 13px;
    color: var(--text-dim);
    font-style: italic;
    line-height: 1.55;
    padding-top: 14px;
    border-top: 1px solid rgba(255,255,255,0.05);
  }
  .tool-total {
    background: rgba(0,212,200,0.06);
    border: 1px solid rgba(0,212,200,0.2);
    padding: 20px 28px;
    margin-top: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }
  .tool-total p {
    font-family: var(--font-display);
    font-size: 14px;
    color: var(--text-muted);
  }
  .tool-total strong {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 800;
    color: var(--teal);
  }

  /* HOW IT WORKS */
  .steps-list {
    margin-top: 48px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .step-row {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 32px;
    background: var(--bg-card);
    border: 1px solid rgba(255,255,255,0.05);
    padding: 32px;
    align-items: flex-start;
    transition: border-color 0.2s;
  }
  .step-row:hover { border-color: rgba(0,212,200,0.15); }
  .step-num-lg {
    font-family: var(--font-display);
    font-size: 52px;
    font-weight: 800;
    background: var(--gradient-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .step-content h3 {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 8px;
  }
  .step-content p {
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.7;
  }
  .step-week {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--teal);
    margin-bottom: 8px;
    background: rgba(0,212,200,0.08);
    padding: 3px 10px;
  }

  /* UPGRADE PATH */
  .upgrade-bg {
    background: var(--bg-surface);
    padding: 88px 0;
  }
  .upgrade-inner {
    max-width: 860px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .upgrade-card {
    background: var(--bg-card);
    border: 1px solid rgba(255,255,255,0.08);
    padding: 52px 48px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .upgrade-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: var(--gradient);
  }
  .upgrade-card::after {
    content: '';
    position: absolute;
    bottom: -100px; left: 50%;
    transform: translateX(-50%);
    width: 400px; height: 400px;
    background: radial-gradient(ellipse, rgba(0,212,200,0.05) 0%, transparent 70%);
    pointer-events: none;
  }
  .upgrade-eyebrow {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--orange);
    margin-bottom: 20px;
  }
  .upgrade-title {
    font-family: var(--font-display);
    font-size: clamp(24px, 3.5vw, 36px);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: 16px;
  }
  .upgrade-title .grad {
    background: var(--gradient-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .upgrade-body {
    font-size: 16px;
    color: var(--text-muted);
    max-width: 520px;
    margin: 0 auto 36px;
    line-height: 1.75;
    font-weight: 300;
  }
  .upgrade-compare {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 36px;
    text-align: left;
  }
  @media (max-width: 600px) { .upgrade-compare { grid-template-columns: 1fr; } }
  .compare-col {
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.06);
    padding: 20px 24px;
  }
  .compare-col h4 {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  .compare-col.diy h4 { color: var(--text-dim); }
  .compare-col.dfy h4 { color: var(--teal); }
  .compare-col ul { list-style: none; }
  .compare-col ul li {
    font-size: 13px;
    color: var(--text-muted);
    padding: 6px 0;
    display: flex;
    gap: 8px;
    border-bottom: 1px solid rgba(255,255,255,0.04);
  }
  .compare-col ul li:last-child { border-bottom: none; }
  .compare-col.diy ul li::before { content: '·'; color: var(--text-dim); }
  .compare-col.dfy ul li::before { content: '✓'; color: var(--teal); font-weight: 700; }

  .btn-upgrade {
    display: inline-block;
    background: var(--gradient);
    color: var(--bg);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 16px 40px;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .btn-upgrade:hover { opacity: 0.88; }
  .upgrade-note {
    font-size: 13px;
    color: var(--text-dim);
    margin-top: 14px;
  }

  /* BOTTOM CTA */
  .bottom-cta {
    padding: 88px 24px;
    max-width: 680px;
    margin: 0 auto;
    text-align: center;
  }
  .bottom-cta .section-label { text-align: center; }
  .bottom-cta .section-title { text-align: center; }
  .bottom-cta .section-body { margin: 0 auto 36px; text-align: center; }

  /* FOOTER */
  footer {
    border-top: 1px solid rgba(255,255,255,0.06);
    padding: 32px 24px;
  }
  .footer-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
  }
  .footer-logo {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.14em;
    color: var(--teal);
    text-transform: uppercase;
  }
  .footer-links {
    display: flex;
    gap: 24px;
  }
  .footer-links a {
    font-size: 13px;
    color: var(--text-dim);
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer-links a:hover { color: var(--text-muted); }
  .footer-copy { font-size: 12px; color: var(--text-dim); }

  /* FADE IN */
  .fade-in {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.55s ease, transform 0.55s ease;
  }
  .fade-in.visible { opacity: 1; transform: translateY(0); }
  @media (prefers-reduced-motion: reduce) {
    .fade-in { opacity: 1; transform: none; transition: none; }
  }

  @media (max-width: 600px) {
    .hero { padding: 110px 20px 72px; }
    .section { padding: 64px 20px; }
    .step-row { grid-template-columns: 60px 1fr; gap: 20px; }
    .upgrade-card { padding: 40px 24px; }
  }
</style>
</head>
