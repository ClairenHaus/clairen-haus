label{font-size:11px;max-width:92px;line-height:1.15;margin-top:3px}.score-outof{font-size:11px;color:var(--muted);margin-top:4px}.rail-card{padding:18px}.rail-card h3{font-size:14px;color:var(--primary);margin:0 0 8px}.rail-card p{font-size:11px;color:var(--muted);margin:0}.calc-list{display:grid;gap:8px;margin-top:10px}.calc-row{font-size:10px;display:grid;grid-template-columns:10px 1fr;gap:7px;align-items:start}.calc-dot{width:7px;height:7px;border-radius:50%;background:var(--primary);margin-top:4px}.next-list{display:grid;gap:12px;margin-top:12px}.next-item{display:grid;grid-template-columns:24px 1fr;gap:9px}.next-num{width:22px;height:22px;border-radius:50%;background:var(--primary);color:white;display:grid;place-items:center;font-size:10px;font-weight:800}.next-item strong{font-size:11px;display:block;line-height:1.25}.next-item span{font-size:10px;color:var(--primary)}.results-cta{display:grid;grid-template-columns:1fr auto;gap:14px;align-items:center;padding:18px;border:1px solid #D9D0EC;border-radius:16px;background:#FBF9FE}.results-cta h3{font-size:13px;color:var(--primary);margin:0 0 3px}.results-cta p{font-size:10px;color:var(--muted);margin:0}.results-cta .btn{font-size:11px;padding:10px 14px;text-decoration:none}.results-tools{display:flex;gap:8px;justify-content:flex-end;margin-bottom:4px}.results-tools .btn{font-size:11px;padding:9px 13px}.results .section-title,.results>.wrap>.score-grid,.results>.wrap>.summary-card,.results>.wrap>.priorities,.results>.wrap>.journey-map,.results>.wrap>.tools,.results>.wrap>.action-box{display:none}
