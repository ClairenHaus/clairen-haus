<body>
<header class="topbar"><div class="wrap brand"><div class="brandmark">Clairen <span>Haus</span></div><div class="step-indicator" id="topStep">Client Journey Mapper</div></div></header>
<main>
<section class="hero" id="hero"><div class="wrap">
  <div class="eyebrow">Free Operations Tool</div>
  <h1>Map the experience your clients actually move through.</h1>
  <p>A useful client journey is more than a list of calls and modules. Map what happens from promise to completion, identify where clients depend on you to keep the process moving, and leave with a short list of fixes.</p>
  <div class="principle"><b>Clarity</b> → Consistency → Adaptability → Scalability</div>
  <div class="intro-grid">
    <div class="card intro-card"><h3>What this mapper looks for</h3><div class="mini-list">
      <div class="mini"><div class="num">01</div><div><strong>Client clarity</strong><span>Can the client tell where they are, what comes next, and what good progress looks like?</span></div></div>
      <div class="mini"><div class="num">02</div><div><strong>Operational ownership</strong><span>Does each step have a trigger, owner, and response when the normal process breaks?</span></div></div>
      <div class="mini"><div class="num">03</div><div><strong>Manual dependence</strong><span>Which recurring delivery steps are you still initiating, sending, checking, updating, or following up on manually?</span></div></div>
    </div></div>
    <div class="card intro-card"><h3>Before you start</h3><p>Answer based on what happens now, not what you intend to build later.</p><div class="mini-list"><div class="mini"><div class="num">7</div><div><strong>Journey stages</strong><span>About 8–12 minutes.</span></div></div><div class="mini"><div class="num">→</div><div><strong>Action plan</strong><span>Your results prioritize the first fixes to make.</span></div></div></div></div>
  </div>
</div></section>
<section class="wrap"><div class="card form-shell" id="mapper">
  <div class="progress-wrap"><div class="progress-track"><div class="progress-fill" id="progressFill"></div></div><div class="progress-text" id="progressText"></div></div>
  <div id="stageContent"></div>
  <div class="nav"><button class="btn btn-secondary" id="backBtn" type="button">Back</button><button class="btn btn-primary" id="nextBtn" type="button">Continue</button></div>
  <div class="save-note">Your answers are saved on this device as you go.</div>
</div></section>
<section class="results" id="results"><div class="wrap">
  <div class="results-tools"><button class="btn btn-secondary" onclick="window.print()">Print Results</button><button class="btn btn-secondary" id="restartBtn">Start Over</button></div>
  <div class="results-dashboard">
    <aside class="results-sidebar">
      <div class="results-panel stage-list"><div class="side-title">Journey Stages</div><div id="stageNavResults"></div></div>
      <div class="results-panel side-progress"><strong style="font-size:12px">Total Progress</strong><div class="bar"><i></i></div><div class="side-progress-row"><span>21 / 21 answered</span><b>100%</b></div></div>
    </aside>
    <div class="results-main">
      <div class="results-head"><div class="eyebrow">Your Results</div><h1 id="resultHeadline">Your delivery system has a clear next move.</h1><p class="results-sub" id="resultSub"></p></div>
      <div class="results-panel panel-pad"><h2 class="panel-title">Journey at a Glance</h2><p class="panel-sub">See where manual work and process gaps are concentrated across the client journey.</p><div class="glance-track" id="glanceTrack"></div><div class="legend"><span><i style="background:#C84B4B"></i>Critical gap</span><span><i style="background:#E58A25"></i>Needs work</span><span><i style="background:#3F945D"></i>Solid</span><span><i style="background:#5B478D"></i>Strong</span></div></div>
      <div class="results-panel panel-pad"><h2 class="panel-title">Score Breakdown</h2><p class="panel-sub">Automation questions carry twice the weight of clarity and process questions.</p><div class="breakdown-grid"><div class="breakdown-box"><b id="autoCount">0</b><strong>Automated</strong><span id="autoPct">0% of automation checks</span></div><div class="breakdown-box"><b id="partialCount">0</b><strong>Partly Automated</strong><span id="partialPct">0% of automation checks</span></div><div class="breakdown-box"><b id="mostlyManualCount">0</b><strong>Mostly Manual</strong><span id="manualPct">0% of automation checks</span></div></div></div>
      <div class="results-panel panel-pad"><h2 class="panel-title">Top Areas of Opportunity</h2><p class="panel-sub">These stages contain the most manual work or unclear process controls.</p><div class="opp-list" id="opportunityList"></div></div>
      <div class="results-cta"><div><h3>See what your journey looks like when repeatable work runs automatically.</h3><p>Explore the Signature Delivery Suite™ and see how a tailored delivery system can handle the routine steps while keeping coaching and judgment human.</p></div><a class="btn btn-primary" href="https://tour.clairenhaus.com" target="_blank" rel="noopener">Explore the Tour →</a></div>
    </div>
    <aside class="results-rail">
      <div class="results-panel rail-score"><div class="rail-label">Your Journey Score</div><div class="score-ring" id="scoreRing"><div class="score-inner"><div class="score-num" id="scoreNum">0</div><div class="score-label">Journey<br>Score</div><div class="score-outof">Out of 100</div></div></div></div>
      <div class="results-panel rail-card"><h3>What Your Score Means</h3><span class="level" id="levelBadge" style="display:inline-block;background:var(--soft);color:var(--primary);padding:4px 7px;border-radius:999px;font-size:9px;font-weight:800;margin-bottom:7px"></span><strong id="levelTitle" style="font-size:12px;display:block;margin-bottom:5px"></strong><p id="levelCopy"></p></div>
      <div class="results-panel rail-card"><h3>How Your Score Is Calculated</h3><div class="calc-list"><div class="calc-row"><i class="calc-dot"></i><span>21 diagnostic checks answered</span></div><div class="calc-row"><i class="calc-dot"></i><span>Automation + manual-work checks count <b>2×</b></span></div><div class="calc-row"><i class="calc-dot"></i><span>Clarity + process checks count <b>1×</b></span></div><div class="calc-row"><i class="calc-dot" style="background:#3F945D"></i><span>Automated / system-driven = 2 points</span></div><div class="calc-row"><i class="calc-dot" style="background:#E58A25"></i><span>Partly automated = 1 point</span></div><div class="calc-row"><i class="calc-dot" style="background:#C84B4B"></i><span>Mostly manual = 0 points</span></div></div></div>
      <div class="results-panel rail-card"><h3>Your Next Steps (Top 3)</h3><div class="next-list" id="nextSteps"></div></div>
    </aside>
  </div>
</div></section>
</main>
<footer class="footer"><div class="wrap">Clairen Haus · Build with clarity. Scale with confidence.</div></footer>
<script>
const stages=[
 {id:'promise',title:'Offer Promise',desc:'Start with the result you sell. Delivery should make that promise visible and understandable before the client ever needs to ask what happens next.',qs:[
  {id:'p1',q:'Is the promised client outcome translated into clear milestones or stages?',help:'A client should be able to understand how the work moves toward the result.'},
  {id:'p2',q:'Can a client see what is included, what is expected of them, and what is outside scope?'},
  {id:'p3',q:'Is the delivery journey documented clearly enough that another team member could explain it consistently?'}],note:'What is the primary outcome your offer promises?'
 },
 {id:'enrollment',title:'Enrollment',desc:'Look at the handoff between “yes” and active delivery. This is where sales momentum either becomes confidence or turns into waiting.',qs:[
  {id:'e1',q:'After payment or agreement, does the next step happen without you manually initiating it?',manual:true},
  {id:'e2',q:'Does the client receive one clear instruction for what to do first?'},
  {id:'e3',q:'Can you tell whether required enrollment steps were completed without checking multiple places?',manual:true}],note:'List the tools or channels a client touches between payment and kickoff.'
 },
 {id:'welcome',title:'Welcome & Kickoff',desc:'A strong welcome removes uncertainty. The client should understand the path, expectations, communication rules, and first meaningful action.',qs:[
  {id:'w1',q:'Does your welcome explain the full journey, not just logistics for the first call?'},
  {id:'w2',q:'Are communication expectations clear, including where to ask questions and expected response times?'},
  {id:'w3',q:'Does the client leave kickoff knowing exactly what happens next?'}],note:'What question do new clients ask most often during their first week?'
 },
 {id:'delivery',title:'Active Delivery',desc:'This is the working center of the offer. Look for recurring work you are still triggering, sending, checking, updating, or following up on manually when the system could handle it.',qs:[
  {id:'d1',q:'Can clients find current materials, assignments, and next actions in one predictable place?'},
  {id:'d2',q:'When a client completes an action, does the next relevant step become clear without you chasing them?',manual:true},
  {id:'d3',q:'Are repeatable delivery steps triggered and moved forward through a defined system instead of being handled manually each time?',manual:true}],note:'What recurring delivery task takes more of your time than it should?'
 },
 {id:'progress',title:'Progress Visibility',desc:'Clients need evidence that they are moving. You need enough visibility to intervene before a small delay becomes a stalled engagement.',qs:[
  {id:'g1',q:'Can the client see completed milestones and remaining work?'},
  {id:'g2',q:'Can you quickly identify clients who are stalled, late, or at risk?',manual:true},
  {id:'g3',q:'Are progress reviews tied to specific evidence instead of general impressions?'}],note:'How do you currently know when a client is falling behind?'
 },
 {id:'communication',title:'Communication',desc:'Premium communication is not “more messages.” It is knowing where communication belongs, what requires a response, and what should happen automatically.',qs:[
  {id:'c1',q:'Is there a primary client communication channel with a clear purpose?'},
  {id:'c2',q:'Are routine reminders and status updates sent without you composing them each time?',manual:true},
  {id:'c3',q:'Can important client decisions and commitments be found later without searching DMs, texts, and email?',manual:true}],note:'Which channels do you currently use with active clients?'
 },
 {id:'completion',title:'Completion & Continuity',desc:'The end of the offer should make the client’s progress visible, close open loops, and create a clear next relationship step.',qs:[
  {id:'f1',q:'Is there a defined completion process instead of the engagement simply ending after the last session?'},
  {id:'f2',q:'Does the client receive a clear record or recap of progress, wins, or completed milestones?'},
  {id:'f3',q:'Is there a defined next step for feedback, testimonial/referral opportunities, continuation, or offboarding?',manual:true}],note:'What happens operationally after the final scheduled client session?'
 }
];
const standardChoices=[{v:2,t:'Yes, consistently'},{v:1,t:'Sometimes / partly'},{v:0,t:'No / not defined'}];
const automationChoices=[{v:2,t:'Automated / system-driven'},{v:1,t:'Partly automated'},{v:0,t:'Mostly manual'}];
let current=0;let answers=JSON.parse(localStorage.getItem('chJourneyAnswers')||'{}');
const el=id=>document.getElementById(id);
function render(){const s=stages[current];el('progressFill').style.width=((current+1)/stages.length*100)+'%';el('progressText').textContent=`${current+1} of ${stages.length}`;el('topStep').textContent=`Client Journey Mapper · ${current+1}/${stages.length}`;el('backBtn').disabled=current===0;el('nextBtn').textContent=current===stages.length-1?'See My Results':'Continue';
 let html=`<div class="stage-header"><div><div class="stage-kicker">Stage ${current+1}</div><h2>${s.title}</h2><p>${s.desc}</p></div><div class="stage-count">3 diagnostic checks</div></div><div class="questions">`;
 s.qs.forEach((x,i)=>{html+=`<div class="question"><label class="q">${x.q}<span class="help">${x.help||''}</span></label><div class="options">${(x.manual?automationChoices:standardChoices).map(c=>`<label class="option"><input type="radio" name="${x.id}" value="${c.v}" ${String(answers[x.id])===String(c.v)?'checked':''}><span>${c.t}</span></label>`).join('')}</div></div>`});
 html+=`<div class="question"><label class="q">${s.note}<span class="help">Optional. Use this to capture what is actually happening today.</span></label><textarea id="note_${s.id}" placeholder="Add a short note...">${answers['note_'+s.id]||''}</textarea></div></div>`;el('stageContent').innerHTML=html;
 document.querySelectorAll('input[type=radio]').forEach(i=>i.addEventListener('change',e=>{answers[e.target.name]=Number(e.target.value);save()}));const n=el('note_'+s.id);n.addEventListener('input',()=>{answers['note_'+s.id]=n.value;save()});window.scrollTo({top:document.getElementById('mapper').offsetTop-80,behavior:'smooth'});
}
function save(){localStorage.setItem('chJourneyAnswers',JSON.stringify(answers))}
function validate(){return stages[current].qs.every(q=>answers[q.id]!==undefined)}
el('nextBtn').onclick=()=>{if(!validate()){alert('Answer the three diagnostic checks before continuing.');return}if(current<stages.length-1){current++;render()}else showResults()};el('backBtn').onclick=()=>{if(current>0){current--;render()}};
function showResults(){
 const allQs=stages.flatMap(s=>s.qs);const max=allQs.reduce((a,q)=>a+2*(q.manual?2:1),0);const total=allQs.reduce((a,q)=>a+(answers[q.id]??0)*(q.manual?2:1),0);const score=Math.round(total/max*100);
 const automationQs=allQs.filter(q=>q.manual);const auto=automationQs.filter(q=>(answers[q.id]??0)===2).length;const partial=automationQs.filter(q=>(answers[q.id]??0)===1).length;const mostlyManual=automationQs.filter(q=>(answers[q.id]??0)===0).length;
 let level,title,copy;if(score>=85){level='Structured';title='Your journey is well controlled.';copy='Most recurring delivery steps are already system-driven. Focus on the remaining manual handoffs and exception rules.'}else if(score>=65){level='Developing';title='The journey works, but it still leans on you.';copy='Several repeatable steps still require manual follow-up, checking, sending, or updating. Those are your best automation opportunities.'}else if(score>=40){level='Reactive';title='Your methodology is doing more work than your system.';copy='Too much of delivery is being moved forward manually. Standardize unclear steps first, then automate the repeatable work.'}else{level='Fragmented';title='Too much of the journey is still being run manually.';copy='Several recurring delivery steps are not yet standardized or automated. Define the normal path, then automate the tasks that do not require your judgment.'}
 el('scoreNum').textContent=score;el('scoreRing').style.background=`conic-gradient(var(--primary) ${score*3.6}deg,#E9E3F1 0deg)`;el('levelBadge').textContent=level;el('levelTitle').textContent=title;el('levelCopy').textContent=copy;el('resultHeadline').textContent='Here’s where your client journey is costing you manual effort.';el('resultSub').textContent=`Your journey scored ${score}/100. The biggest opportunities below show where repeatable delivery work can be automated or standardized.`;
 const stageScores=stages.map(s=>{const stageMax=s.qs.reduce((a,q)=>a+2*(q.manual?2:1),0);const points=s.qs.reduce((a,q)=>a+(answers[q.id]??0)*(q.manual?2:1),0);return {...s,points,maxPoints:stageMax,score:Math.round(points/stageMax*100)}});
 el('stageNavResults').innerHTML=stageScores.map((s,i)=>`<div class="stage-nav-item"><div class="stage-nav-num">${i+1}</div><div><strong>${s.title}</strong><span>${s.qs.length} / ${s.qs.length} answered · ${s.points}/${s.maxPoints} pts</span></div></div>`).join('');
 el('glanceTrack').innerHTML=stageScores.map((s,i)=>{const cls=s.score<40?'bad':s.score<65?'mid':s.score<85?'good':'strong';return `<div class="glance-stage"><div class="glance-node ${cls}">${i+1}</div><div class="glance-label">${s.title}</div><div class="glance-score">${s.points} / ${s.maxPoints}</div></div>`}).join('');
 el('autoCount').textContent=auto;el('partialCount').textContent=partial;el('mostlyManualCount').textContent=mostlyManual;const aq=automationQs.length||1;el('autoPct').textContent=`${Math.round(auto/aq*100)}% of automation checks`;el('partialPct').textContent=`${Math.round(partial/aq*100)}% of automation checks`;el('manualPct').textContent=`${Math.round(mostlyManual/aq*100)}% of automation checks`;
 const issues=[];stages.forEach(s=>s.qs.forEach(q=>{const v=answers[q.id]??0;if(v<2)issues.push({id:q.id,stage:s.title,q:q.q,v,manual:q.manual})}));issues.sort((a,b)=>(b.manual?1:0)-(a.manual?1:0) || a.v-b.v);
 const stageIssues=stageScores.map(s=>{const related=issues.filter(x=>x.stage===s.title);const manualGaps=related.filter(x=>x.manual).length;return {...s,related,manualGaps}}).filter(s=>s.related.length).sort((a,b)=>b.manualGaps-a.manualGaps || a.score-b.score).slice(0,3);
 el('opportunityList').innerHTML=stageIssues.length?stageIssues.map((s,i)=>{const first=s.related[0];return `<div class="opp-item"><div class="opp-rank">${i+1}</div><div><strong>${s.title}</strong><p>${first?fixCopy(first):stageMessage(s.score)}</p></div><span class="opp-score">${s.points}/${s.maxPoints}</span></div>`}).join(''):`<div class="opp-item"><div class="opp-rank">✓</div><div><strong>No major gaps found</strong><p>Your next work is documenting exception paths and monitoring where manual work still appears.</p></div></div>`;
 const fixes=issues.slice(0,3);el('nextSteps').innerHTML=fixes.length?fixes.map((x,i)=>`<div class="next-item"><div class="next-num">${i+1}</div><div><strong>${x.stage}: ${fixTitle(x)}</strong><span>${x.manual?'Automation recommendation':'Process recommendation'} →</span></div></div>`).join(''):`<div class="next-item"><div class="next-num">✓</div><div><strong>Document your exception paths.</strong><span>Advanced recommendation →</span></div></div>`;
 el('hero').style.display='none';el('mapper').parentElement.style.display='none';el('results').style.display='block';el('topStep').textContent='Client Journey Mapper · Results';window.scrollTo({top:0,behavior:'smooth'});
}
const automationAdvice={
 e1:'Connect payment or signed agreement to the next action automatically: confirmation, onboarding instructions, intake, scheduling, or portal access.',
 e3:'Create one status view that updates from completed enrollment actions so you do not have to check multiple tools to see who is ready.',
 d2:'Use completion triggers so the next assignment, message, milestone, or scheduling step is released automatically when the client finishes the current action.',
 d3:'Turn the repeatable delivery sequence into a workflow with defined triggers, actions, owners, and exception points. The normal path should move without manual handling.',
 g2:'Create automatic status rules for overdue, stalled, or at-risk clients and surface those exceptions in one coach view.',
 c2:'Automate routine reminders, confirmations, due-date notices, and status updates. Save manual communication for coaching, judgment, and exceptions.',
 c3:'Centralize important client decisions and commitments so they are captured in the client record instead of requiring searches across DMs, texts, and email.',
 f3:'Trigger the completion sequence automatically: feedback request, testimonial/referral request, continuation option, offboarding tasks, and final resources.'
};
function fixTitle(x){if(x.manual)return x.v===0?'automate this recurring step':'finish automating this step';if(/client|next|journey|milestone/i.test(x.q))return 'make the next step visible';if(/communication|channel|DM|email/i.test(x.q))return 'set one communication rule';if(/progress|stalled|risk/i.test(x.q))return 'create a progress signal';return 'define the operating rule'}
function fixCopy(x){if(x.manual)return automationAdvice[x.id] || 'Define the trigger and expected action, then automate the repeatable part so it does not require manual initiation or follow-up.';if(/client|next|journey|milestone/i.test(x.q))return 'Reduce the number of decisions the client has to make. Give the step one location, one clear action, and an obvious definition of done.';if(/communication|channel|DM|email/i.test(x.q))return 'Decide what belongs in each channel, what requires a response, and where important decisions are recorded.';if(/progress|stalled|risk/i.test(x.q))return 'Choose a visible milestone or status that tells both you and the client whether the engagement is moving as expected.';return 'Document what should happen consistently, who owns it, and what changes when the normal process breaks.'}
function stageMessage(s){return s>=80?'Strong foundation':s>=50?'Needs tighter controls':'High-friction stage'}
el('restartBtn').onclick=()=>{if(confirm('Clear your saved answers and start over?')){localStorage.removeItem('chJourneyAnswers');answers={};current=0;el('hero').style.display='block';el('mapper').parentElement.style.display='block';el('results').style.display='none';render();window.scrollTo({top:0,behavior:'smooth'})}};
render();
</script>
